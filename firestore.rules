rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (!('defaultDuration' in data) || (data.defaultDuration is string && data.defaultDuration.size() <= 10)) &&
             (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string);
    }

    function isValidVideoProject(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.label is string && data.label.size() <= 32 &&
             data.duration is string && data.duration.size() <= 16 &&
             data.prompt is string && data.prompt.size() <= 10000 &&
             (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 2048)) &&
             (!('driveFileId' in data) || (data.driveFileId is string && data.driveFileId.size() <= 256)) &&
             (!('driveWebViewLink' in data) || (data.driveWebViewLink is string && data.driveWebViewLink.size() <= 2048)) &&
             (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string);
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Users cannot list other users
      allow create: if isOwner(userId) && isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().keys().hasAll(['userId', 'email']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'defaultDuration', 'createdAt']);
      allow update: if isOwner(userId) && isValidId(userId) &&
                       isValidUser(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['defaultDuration', 'email']);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Video Projects Collection
    match /video_projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId) &&
                       isValidVideoProject(incoming()) &&
                       incoming().keys().hasAll(['userId', 'label', 'duration', 'prompt']) &&
                       incoming().keys().hasOnly(['userId', 'label', 'duration', 'prompt', 'videoUrl', 'driveFileId', 'driveWebViewLink', 'createdAt']);
      allow update: if isSignedIn() && isValidId(projectId) &&
                       existing().userId == request.auth.uid &&
                       isValidVideoProject(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['driveFileId', 'driveWebViewLink', 'videoUrl', 'prompt', 'label', 'duration']);
      allow delete: if isSignedIn() && isValidId(projectId) && resource.data.userId == request.auth.uid;
    }
  }
}
